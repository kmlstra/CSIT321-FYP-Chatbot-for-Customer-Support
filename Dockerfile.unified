# Unified Dockerfile for Automotive Chatbot Platform
# Contains Frontend (Next.js), Backend (FastAPI), RASA, Redis, and Nginx
# Multi-stage build for optimized production deployment

# Stage 1: Base image with system dependencies
FROM ubuntu:20.04 AS base

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install system dependencies and Python 3.9.14
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    gnupg2 \
    software-properties-common \
    supervisor \
    nginx \
    redis-server \
    gcc \
    g++ \
    make \
    build-essential \
    libssl-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libncurses5-dev \
    libncursesw5-dev \
    xz-utils \
    tk-dev \
    libffi-dev \
    liblzma-dev \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y python3.9 python3.9-dev python3.9-venv python3.9-distutils \
    && curl https://bootstrap.pypa.io/get-pip.py | python3.9 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.9 1 \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 18
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs

# Stage 2: Frontend Builder
FROM base AS frontend-builder
WORKDIR /app/frontend

# Copy frontend package files
COPY ./WireFrames/automotive_chatbot/frontend/package.json ./
# Note: package-lock.json doesn't exist, so we skip it

# Install frontend dependencies
RUN npm install

# Copy frontend source code
COPY ./WireFrames/automotive_chatbot/frontend/ ./

# Build frontend with proper environment variables for AWS deployment
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV NEXT_PUBLIC_ENV=production
ENV NEXT_PUBLIC_API_URL=http://13.215.240.173:8000
ENV NEXT_PUBLIC_RASA_URL=http://13.215.240.173:5005
ENV NEXT_PUBLIC_FRONTEND_URL=http://13.215.240.173
ENV NEXT_PUBLIC_BACKEND_URL=http://13.215.240.173:8000

# Build the Next.js application
RUN npm run build

# Stage 3: Backend Builder
FROM base AS backend-builder
WORKDIR /app/backend

# Copy backend requirements
COPY ./WireFrames/automotive_chatbot/backend/requirements.txt ./

# Create unified virtual environment and install all dependencies
RUN python3 -m venv /app/venv
ENV PATH="/app/venv/bin:$PATH"
RUN pip install --upgrade pip
RUN pip install -r requirements.txt
# Install RASA in the same environment
RUN pip install rasa==3.6.4 rasa-sdk==3.6.1

# Copy backend source code
COPY ./WireFrames/automotive_chatbot/backend/ ./

# Stage 4: RASA Builder (using unified environment)
FROM backend-builder AS rasa-builder
WORKDIR /app/rasa

# Use the same virtual environment from backend-builder
ENV PATH="/app/venv/bin:$PATH"

# Copy RASA files from backend directory (where they actually are)
COPY ./WireFrames/automotive_chatbot/backend/config.yml ./
COPY ./WireFrames/automotive_chatbot/backend/domain.yml ./
COPY ./WireFrames/automotive_chatbot/backend/credentials.yml ./
COPY ./WireFrames/automotive_chatbot/backend/endpoints.yml ./
COPY ./WireFrames/automotive_chatbot/backend/data/ ./data/
# Copy RASA endpoints from rasa directory
COPY ./WireFrames/automotive_chatbot/rasa/endpoints.yml ./endpoints-rasa.yml

# Train RASA model if needed
RUN if [ -f "domain.yml" ] && [ -f "config.yml" ]; then rasa train; fi

# Stage 5: Final Production Image
FROM base AS production

# Create application directories
RUN mkdir -p /app/frontend /app/backend /app/rasa /app/logs /app/cache

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Copy built frontend from frontend-builder
COPY --from=frontend-builder /app/frontend/.next/standalone /app/frontend/
COPY --from=frontend-builder /app/frontend/.next/static /app/frontend/.next/static
COPY --from=frontend-builder /app/frontend/public /app/frontend/public
# Copy frontend source code for runtime access
COPY --from=frontend-builder /app/frontend/src /app/frontend/src
COPY --from=frontend-builder /app/frontend/package.json /app/frontend/package.json
# Copy node_modules for runtime dependencies (needed for standalone mode)
COPY --from=frontend-builder /app/frontend/node_modules /app/frontend/node_modules

# Copy backend with unified virtual environment
COPY --from=backend-builder /app/venv /app/venv
COPY --from=backend-builder /app/backend /app/backend

# Copy RASA (using same unified virtual environment)
COPY --from=rasa-builder /app/rasa /app/rasa

# Configure Nginx
COPY ./WireFrames/automotive_chatbot/nginx.conf /etc/nginx/nginx.conf

# Create custom Nginx configuration for unified deployment
RUN cat > /etc/nginx/sites-available/default << 'EOF'
server {
    listen 80 default_server;
    server_name _;
    
    # Serve Next.js static files directly (standalone mode)
    location /_next/static/ {
        alias /app/frontend/.next/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri $uri/ @frontend;
    }
    
    # Serve public static files
    location /static/ {
        alias /app/frontend/public/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri $uri/ @frontend;
    }
    
    # Serve favicon and other root-level static files
    location ~* \.(ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot)$ {
        root /app/frontend/public;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri $uri/ @frontend;
    }
    
    # API routes
    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # Health check
    location /health {
        proxy_pass http://127.0.0.1:8000/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # RASA webhooks
    location /webhooks/ {
        proxy_pass http://127.0.0.1:5005/webhooks/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # Frontend fallback for static files
    location @frontend {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # Frontend routes (catch-all)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
EOF

# Configure Redis
RUN sed -i 's/^daemonize yes/daemonize no/' /etc/redis/redis.conf
RUN sed -i 's/^bind 127.0.0.1/bind 0.0.0.0/' /etc/redis/redis.conf

# Create supervisor configuration
RUN cat > /etc/supervisor/conf.d/supervisord.conf << 'EOF'
[supervisord]
nodaemon=true
user=root
logfile=/app/logs/supervisord.log
pidfile=/app/logs/supervisord.pid

[program:redis]
command=redis-server /etc/redis/redis.conf
autostart=true
autorestart=true
user=redis
stdout_logfile=/app/logs/redis.log
stderr_logfile=/app/logs/redis.log

[program:backend]
command=/app/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 2
directory=/app/backend
autostart=true
autorestart=true
user=appuser
environment=PYTHONPATH="/app/backend",PYTHONUNBUFFERED="1"
stdout_logfile=/app/logs/backend.log
stderr_logfile=/app/logs/backend.log

[program:rasa]
command=/app/venv/bin/rasa run --enable-api --cors "*" --port 5005
directory=/app/rasa
autostart=true
autorestart=true
user=appuser
stdout_logfile=/app/logs/rasa.log
stderr_logfile=/app/logs/rasa.log

[program:rasa-actions]
command=/app/venv/bin/rasa run actions --port 5055
directory=/app/rasa
autostart=true
autorestart=true
user=appuser
stdout_logfile=/app/logs/rasa-actions.log
stderr_logfile=/app/logs/rasa-actions.log

[program:frontend]
command=node server.js
directory=/app/frontend
autostart=true
autorestart=true
user=appuser
environment=NODE_ENV="production",PORT="3000",HOSTNAME="0.0.0.0",NEXT_PUBLIC_ENV="production",NEXT_PUBLIC_DOMAIN="http://13.215.240.173",NEXT_PUBLIC_API_URL="http://127.0.0.1:8000",NEXT_PUBLIC_RASA_URL="http://127.0.0.1:5005",NEXT_PUBLIC_FRONTEND_URL="http://13.215.240.173",NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:8000"
stdout_logfile=/app/logs/frontend.log
stderr_logfile=/app/logs/frontend.log

[program:nginx]
command=nginx -g "daemon off;"
autostart=true
autorestart=true
user=root
stdout_logfile=/app/logs/nginx.log
stderr_logfile=/app/logs/nginx.log
EOF

# Set proper permissions
RUN chown -R appuser:appuser /app/frontend /app/backend /app/rasa /app/logs /app/cache
RUN chmod +x /app/frontend/server.js 2>/dev/null || true

# Environment variables
ENV NODE_ENV=production
ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# MongoDB Atlas configuration
ENV MONGODB_TYPE=atlas
ENV MONGODB_DATABASE=automotive_chatbot
ENV MONGODB_COLLECTION_APPOINTMENTS=appointments
ENV MONGODB_COLLECTION_CUSTOMERS=customers
ENV MONGODB_COLLECTION_SERVICES=services
ENV MONGODB_COLLECTION_CHAT_HISTORY=chat_history

# Cache configuration
ENV CACHE_ENABLED=true
ENV CACHE_TTL=1800
ENV CACHE_MAX_SIZE=1000

# Security settings
ENV CORS_ORIGINS="*"
ENV ALLOWED_HOSTS="*"

# Feature flags
ENV FEATURE_APPOINTMENTS=true
ENV FEATURE_EMAIL_NOTIFICATIONS=true
ENV FEATURE_CHAT_HISTORY=true
ENV FEATURE_ANALYTICS=true

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Expose port
EXPOSE 80

# Start all services with supervisor
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
# Domain Configuration - Base domain for all services
DOMAIN=http://54.254.180.103

# Port Configuration - Individual service ports
FRONTEND_PORT=80
BACKEND_PORT=8000
RASA_PORT=5005
RASA_ACTIONS_PORT=5055

# Frontend Environment Variables (NEXT_PUBLIC_ prefix for client-side access)
NEXT_PUBLIC_DOMAIN=http://54.254.180.103
NEXT_PUBLIC_FRONTEND_PORT=80
NEXT_PUBLIC_BACKEND_PORT=8000
NEXT_PUBLIC_RASA_PORT=5005

# Security
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=false

# RASA Configuration  
RASA_HOST=0.0.0.0
RASA_TOKEN=
RASA_ACTION_ENDPOINT_URL=${DOMAIN}:${RASA_ACTIONS_PORT}/webhook

# API Configuration
API_HOST=0.0.0.0

# CORS Configuration - AWS production
CORS_ORIGINS=http://54.254.180.103,http://54.254.180.103:80,http://54.254.180.103:8000,http://localhost:3000,http://127.0.0.1:3000

# COE Data API Configuration (data.gov.sg)

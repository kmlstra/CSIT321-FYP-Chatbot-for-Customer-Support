# ========================================
# ENVIRONMENT CONFIGURATION  
# ========================================
# Core environment variables for automotive chatbot

# ========================================
# DYNAMIC DOMAIN CONFIGURATION SYSTEM
# ========================================
# This system allows seamless switching between localhost and production environments
# 
# FOR LOCALHOST DEVELOPMENT:
DOMAIN=http://localhost
# 
# FOR PRODUCTION DEPLOYMENT (replace with your actual domain/IP):
# DOMAIN=http://54.254.180.103
# DOMAIN=https://yourdomain.com
# 
# The RASA endpoints.yml file is automatically generated by start_rasa.py
# using the RASA_ACTION_ENDPOINT_URL which combines DOMAIN + RASA_ACTIONS_PORT
# This eliminates the need to manually edit endpoints.yml when switching environments

# Domain Configuration - Base domain for all services
# FOR PRODUCTION DEPLOYMENT: Use AWS IP
# DOMAIN=http://54.254.180.103
# FOR LOCAL DEVELOPMENT: Uncomment the line below
DOMAIN=http://localhost

# Port Configuration - Individual service ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
RASA_PORT=5005
RASA_ACTIONS_PORT=5055

# Frontend Environment Variables (NEXT_PUBLIC_ prefix for client-side access)
# These use the unified domain:port approach
# NEXT_PUBLIC_DOMAIN=http://54.254.180.103
# FOR LOCAL DEVELOPMENT: Uncomment the line below
NEXT_PUBLIC_DOMAIN=http://localhost
NEXT_PUBLIC_FRONTEND_PORT=3000
NEXT_PUBLIC_BACKEND_PORT=8000
NEXT_PUBLIC_RASA_PORT=5005
# Security
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=true

# RASA Configuration  
RASA_HOST=0.0.0.0
RASA_TOKEN=
RASA_ACTION_ENDPOINT_URL=${DOMAIN}:${RASA_ACTIONS_PORT}/webhook

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Unified URL Configuration - Uses DOMAIN + PORT approach
# This makes it easier to configure - just change DOMAIN and all URLs update
# Format: ${DOMAIN}:${PORT}
# Note: These are constructed dynamically in code using DOMAIN + PORT variables

# CORS Configuration - Uses unified domain approach
# Format: ${DOMAIN}:${FRONTEND_PORT},${DOMAIN}:${BACKEND_PORT}
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# COE Data API Configuration (data.gov.sg)
COE_DATASET_ID=d_69b3380ad7e51aff3a7dcc84eba52b8a
COE_API_URL=https://data.gov.sg/api/action/datastore_search

# LTA DataMall API Configuration (Optional - for additional services)
LTA_API_KEY=MISSING_LTA_API_KEY
LTA_BASE_URL=https://datamall2.mytransport.sg/ltaodataservice/

# Rate Limiting Configuration
LTA_RATE_LIMIT_REQUESTS=100
LTA_RATE_LIMIT_WINDOW=3600
LTA_MIN_REQUEST_INTERVAL=10
CACHE_EXPIRY_MINUTES=30

# Email Configuration (Optional - for notifications)
EMAIL_PASSWORD=ykwswiqeifplzatx
GMAIL_APP_PASSWORD=ykwswiqeifplzatx

# OpenAI API (Optional - for enhanced AI features)
OPENAI_API_KEY=

# Authentication
AUTH_ENABLED=false

# Logging
LOG_LEVEL=INFO

# SQLAlchemy and Deprecation Warning Suppression
# Suppress SQLAlchemy 2.0 compatibility warnings from RASA
SQLALCHEMY_SILENCE_UBER_WARNING=1
SQLALCHEMY_WARN_20=0
# Suppress distutils deprecation warnings
PYTHONWARNINGS=ignore::DeprecationWarning

# Database Configuration - MongoDB Atlas
MONGODB_URL=mongodb+srv://CleverAdmin:P%40ssw0rd%211@clevercompanioncluster.ygakb6r.mongodb.net/?retryWrites=true&w=majority&appName=AiChatBot
MONGODB_DB=automotive_chatbot_saas
CHATBOT_MONGODB_URL=mongodb+srv://CleverAdmin:P%40ssw0rd%211@clevercompanioncluster.ygakb6r.mongodb.net/?retryWrites=true&w=majority&appName=AiChatBot

# Environment and Profile Configuration
NEXT_PUBLIC_ENV=development
PROFILE_PICTURE_URL=${DOMAIN}:${BACKEND_PORT}/static/media/images/boy.png

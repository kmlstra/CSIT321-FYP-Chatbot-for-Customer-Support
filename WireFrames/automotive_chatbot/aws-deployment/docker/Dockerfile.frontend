# Production build for Next.js frontend
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Install dependencies
COPY ./frontend/package.json ./frontend/package-lock.json* ./
RUN npm install

# Copy source code
COPY ./frontend/ .

# Environment variables
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV PORT=80
ENV HOSTNAME="0.0.0.0"

# Production environment variables - these must be set at build time for Next.js
ENV NEXT_PUBLIC_ENV=production
ENV NEXT_PUBLIC_DOMAIN=http://54.254.180.103
ENV NEXT_PUBLIC_API_URL=http://54.254.180.103:8000/api
ENV NEXT_PUBLIC_RASA_URL=http://54.254.180.103:5005
ENV NEXT_PUBLIC_WIDGET_URL=http://54.254.180.103
ENV NEXT_PUBLIC_FRONTEND_URL=http://54.254.180.103
ENV NEXT_PUBLIC_BACKEND_URL=http://54.254.180.103:8000
ENV NEXT_PUBLIC_FRONTEND_PORT=80
ENV NEXT_PUBLIC_BACKEND_PORT=8000
ENV NEXT_PUBLIC_RASA_PORT=5005
ENV NEXT_PUBLIC_DEBUG=false

# Build the application with production environment variables
RUN npm run build

# Expose port
EXPOSE 80

# Start the application in production mode
CMD ["npm", "start"]
# RASA Server Dockerfile - Simplified
FROM rasa/rasa:3.6.4-full

# Set environment variables
ENV RASA_HOME=/app
ENV PYTHONUNBUFFERED=1

# Switch to root to install dependencies
USER root

# Create necessary directories
RUN mkdir -p /app/models /app/logs /app/data

# Set work directory
WORKDIR /app

# Copy RASA configuration files
COPY ./backend/config.yml .
COPY ./backend/domain.yml .
COPY ./backend/endpoints.yml .
COPY ./backend/credentials.yml .

# Copy training data
COPY ./backend/data/ ./data/

# Create models directory (models will be trained on startup if none exist)
RUN mkdir -p ./models

# Copy custom actions and API dependencies
COPY ./backend/actions.py .
COPY ./backend/api/ ./api/
COPY ./backend/requirements.txt .

# Install additional dependencies for custom actions
RUN pip install --no-cache-dir -r requirements.txt

# Use existing rasa user from base image
RUN chown -R 1001:1001 /app
USER 1001

# Expose ports
EXPOSE 5005 5055

# Create startup script
RUN echo '#!/bin/bash\n\
set -e\n\
echo "Starting RASA server..."\n\
if [ ! -f models/*.tar.gz ] && [ ! -f models/*.pkl ]; then\n\
  echo "No trained model found, training new model..."\n\
  rasa train --config config.yml --domain domain.yml --data data/ --out models/\n\
fi\n\
echo "Starting RASA API server..."\n\
exec rasa run --enable-api --model models --cors "*" --debug --endpoints endpoints.yml --port 5005 --interface 0.0.0.0' > /app/start-rasa.sh && chmod +x /app/start-rasa.sh

# Start RASA server
CMD ["/app/start-rasa.sh"]
# Optimized Production Dockerfile for RASA Server
# Multi-stage build for better performance and security

# Stage 1: Base RASA image
FROM rasa/rasa:3.6.4-full AS base

# Install system dependencies
USER root
RUN apt-get update && apt-get install -y \
    curl \
    dumb-init \
    && rm -rf /var/lib/apt/lists/*

# Stage 2: Builder
FROM base AS builder
WORKDIR /app

# Copy RASA configuration and training data
COPY ./backend/ .

# Copy actions requirements
COPY ./backend/requirements.txt ./requirements.txt

# Install custom actions dependencies
RUN pip install --no-cache-dir -r ./requirements.txt

# Force reinstall packaging==20.9 to fix LegacyVersion import issue
RUN pip install packaging==20.9 --force-reinstall --no-deps
# Also ensure pyparsing compatibility
RUN pip install pyparsing==2.4.7 --force-reinstall --no-deps
# Fix JWT dependency to resolve InvalidKeyError import issue
RUN pip install PyJWT==2.4.0 --force-reinstall

# Stage 3: Runner
FROM base AS runner
WORKDIR /app

# Copy Python dependencies from builder
COPY --from=builder /opt/venv /opt/venv

# Copy RASA files and custom actions
COPY --from=builder /app .

# Copy custom actions from backend
COPY ./backend/api/actions/ ./actions/

# Create necessary directories
RUN mkdir -p /app/logs /app/models /app/cache && \
    chown -R 1001:1001 /app

# Environment variables for RASA
ENV RASA_MODEL_SERVER=http://localhost:5005
ENV RASA_ACTION_ENDPOINT=http://localhost:5055/webhook
ENV RASA_CORS_ORIGINS="*"
ENV RASA_ENABLE_API=true
ENV RASA_RESPONSE_TIMEOUT=3600
ENV RASA_LOG_LEVEL=INFO

# MongoDB Atlas configuration for actions
ENV MONGODB_TYPE=atlas
ENV MONGODB_ATLAS_URI=""
ENV MONGODB_DATABASE=automotive_chatbot
ENV MONGODB_COLLECTION_APPOINTMENTS=appointments
ENV MONGODB_COLLECTION_CUSTOMERS=customers
ENV MONGODB_COLLECTION_SERVICES=services
ENV MONGODB_COLLECTION_CHAT_HISTORY=chat_history

# Database connection pool settings
ENV DB_POOL_MIN_SIZE=5
ENV DB_POOL_MAX_SIZE=20
ENV DB_POOL_MAX_IDLE_TIME=30000
ENV DB_CONNECTION_TIMEOUT=10000
ENV DB_SERVER_SELECTION_TIMEOUT=5000
ENV DB_RETRY_WRITES=true
ENV DB_W=majority

# Cache configuration
ENV CACHE_ENABLED=true
ENV CACHE_TTL=1800
ENV CACHE_MAX_SIZE=500
ENV CACHE_CLEANUP_INTERVAL=300

# Email configuration for actions
ENV SMTP_SERVER=""
ENV SMTP_PORT=587
ENV SMTP_USERNAME=""
ENV SMTP_PASSWORD=""
ENV SMTP_USE_TLS=true
ENV EMAIL_FROM=""

# Feature flags
ENV FEATURE_APPOINTMENTS=true
ENV FEATURE_EMAIL_NOTIFICATIONS=true
ENV FEATURE_CHAT_HISTORY=true
ENV FEATURE_ANALYTICS=true

# Performance settings
ENV RASA_WORKERS=2
ENV RASA_MAX_REQUESTS=1000
ENV RASA_BACKLOG=100

# Security settings
ENV RASA_JWT_SECRET=""
ENV RASA_JWT_METHOD=HS256

# Monitoring settings
ENV HEALTH_CHECK_ENABLED=true
ENV METRICS_ENABLED=true

# Copy and set up startup scripts
USER root
COPY ./start-rasa-fixed.sh /app/start-rasa.sh
COPY ./start-rasa-actions.sh /app/start-rasa-actions.sh
COPY ./endpoints.yml /app/endpoints.yml
RUN chmod +x /app/start-rasa.sh /app/start-rasa-actions.sh && chown 1001:1001 /app/start-rasa.sh /app/start-rasa-actions.sh /app/endpoints.yml

# Switch to RASA user
USER 1001

# Expose ports
EXPOSE 5005

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5005/status || exit 1

# Completely override the base image's ENTRYPOINT to avoid argument parsing issues
# The base rasa image has ENTRYPOINT ["rasa"] which causes argument parsing conflicts
ENTRYPOINT []
CMD ["/usr/bin/dumb-init", "--", "/bin/bash", "/app/start-rasa.sh"]
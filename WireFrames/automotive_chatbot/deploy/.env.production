# Production Environment Configuration for AWS EC2 Deployment
# Copy this file to .env and update the values for your production environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB Atlas Connection (Replace with your actual connection string)
MONGODB_URL=mongodb+srv://CleverAdmin:P%40ssw0rd%211@clevercompanioncluster.ygakb6r.mongodb.net/?retryWrites=true&w=majority&appName=AiChatBot
MONGODB_DB=automotive_chatbot_saas
CHATBOT_MONGODB_URL=mongodb+srv://CleverAdmin:P%40ssw0rd%211@clevercompanioncluster.ygakb6r.mongodb.net/?retryWrites=true&w=majority&appName=AiChatBot


# =============================================================================
# APPLICATION SECURITY
# =============================================================================
# JWT Secret Key (Generate a strong random key for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Redis Password (Generate a strong password)
REDIS_PASSWORD=your-redis-password-change-this

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins for CORS (Update with your domain)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Authentication
AUTH_ENABLED=false

# Logging Level
LOG_LEVEL=INFO

# =============================================================================
# PORT CONFIGURATION
# =============================================================================
# Backend API Port
BACKEND_PORT=8001

# Frontend Port
FRONTEND_PORT=3000

# RASA API Port
RASA_PORT=5005

# RASA Actions Port
RASA_ACTIONS_PORT=5055

# Nginx Ports
NGINX_PORT=80
NGINX_SSL_PORT=443

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# API URLs (Update with your EC2 instance public IP or domain)
NEXT_PUBLIC_API_URL=http://your-ec2-public-ip:8001
NEXT_PUBLIC_RASA_URL=http://your-ec2-public-ip:5005

# =============================================================================
# AWS EC2 SPECIFIC CONFIGURATION
# =============================================================================
# EC2 Instance Details (for reference)
# EC2_INSTANCE_ID=i-1234567890abcdef0
# EC2_PUBLIC_IP=1.2.3.4
# EC2_PRIVATE_IP=172.31.1.1
# AWS_REGION=us-east-1

# =============================================================================
# SSL/TLS CONFIGURATION (Optional)
# =============================================================================
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
# Enable production monitoring
ENABLE_MONITORING=true

# Log retention (days)
LOG_RETENTION_DAYS=30

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Worker processes
WORKER_PROCESSES=auto

# Max connections per worker
WORKER_CONNECTIONS=1024

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention (days)
BACKUP_RETENTION_DAYS=7

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
# Health check intervals
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
# Multi-stage build for RASA + FastAPI Backend
FROM python:3.9-slim as base

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    gcc \
    g++ \
    libffi-dev \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set working directory
WORKDIR /app

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app

# Copy requirements first for better caching
COPY backend/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install packaging==20.9 --force-reinstall --no-deps

# Copy backend application code
COPY backend/ .

# Create necessary directories with proper permissions
RUN mkdir -p cache/coe_data logs models static results \
    && chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Pre-train RASA model (optional - can be done at runtime)
# Uncomment the next line if you want to train during build
# RUN python -m rasa train --force

# Expose ports
EXPOSE 8001 5005 5055

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Create startup script for production
RUN echo '#!/bin/bash\n\
set -e\n\
echo "Starting RASA training..."\n\
python -m rasa train --force\n\
echo "Starting RASA actions server..."\n\
python -m rasa run actions --actions api.actions.rasa_actions --port 5055 &\n\
echo "Starting RASA API server..."\n\
python -m rasa run --enable-api --cors "*" --port 5005 --endpoints endpoints.yml &\n\
echo "Starting FastAPI server..."\n\
python -m uvicorn api.main:app --host 0.0.0.0 --port 8001\n' > /app/start.sh \
    && chmod +x /app/start.sh

# Default command for production
CMD ["/app/start.sh"]
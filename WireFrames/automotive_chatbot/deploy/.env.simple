# Simple Production Environment Configuration
# Copy this file to .env and update the values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB Atlas connection string
# Get this from your MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/automotive_chatbot?retryWrites=true&w=majority

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# JWT Secret for authentication (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Allowed origins for CORS (update with your domain)
CORS_ORIGINS=http://localhost:3000,http://your-domain.com

# ===========================================
# API CONFIGURATION
# ===========================================
# Backend API settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
RASA_URL=http://localhost:5005

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
# Node environment
NODE_ENV=production

# API URLs (update with your server IP)
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_RASA_URL=http://localhost:5005

# ===========================================
# OPTIONAL: EXTERNAL API KEYS
# ===========================================
# OpenAI API Key (if using GPT features)
# OPENAI_API_KEY=your-openai-api-key

# LTA API Key (if using Singapore transport data)
# LTA_API_KEY=your-lta-api-key

# ===========================================
# SYSTEM CONFIGURATION
# ===========================================
# Logging level
LOG_LEVEL=INFO

# Session settings
SESSION_TIMEOUT=3600

# File upload limits
MAX_FILE_SIZE=10485760